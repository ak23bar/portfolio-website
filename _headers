# Cloudflare Pages reads this file; the <meta http-equiv="Cache-Control"> tags in
# the Matrix document are ignored by browsers for HTTP caching, so this is the
# site's only real caching policy. Effect is observable only on a deploy, never
# under `python3 -m http.server`.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
